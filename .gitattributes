# Normalize text files in the repository
* text=auto

# Source code and project documentation
*.py   text eol=lf
*.md   text eol=lf
*.txt  text eol=lf
*.csv  text eol=lf
*.json text eol=lf
*.toml text eol=lf
*.yml  text eol=lf
*.yaml text eol=lf

# Windows command files
*.bat  text eol=crlf
*.cmd  text eol=crlf
*.ps1  text eol=crlf

# Binary artifacts
*.xlsx binary
*.xlsm binary
*.xls binary
*.png binary
*.jpg binary
*.jpeg binary
*.gif binary
*.pdf binary
